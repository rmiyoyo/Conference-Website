{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{- if eq .Page.Current "missing"}}
<base href="/Conference-Website/">
{{- end}}
<title>{{with .Page.Title}}{{.}}: {{end}}{{.Event.Name}} {{.Event.Year}}</title>
<meta name="description" content="{{.Event.Name}}, {{.Event.Dates}}, at the {{.Venue.Name}} in Nairobi.">
<meta name="theme-color" content="#272a31">
<meta property="og:type" content="website">
<meta property="og:title" content="{{.Event.Name}} {{.Event.Year}}">
<meta property="og:description" content="{{.Event.Dates}}, at the {{.Venue.Name}} in Nairobi.">
<meta property="og:url" content="{{.Event.URL}}{{.Page.File}}">
<meta property="og:image" content="{{.Event.URL}}images/logos/CS.png">
<link rel="icon" href="images/logos/CS.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&amp;display=swap">
<link rel="stylesheet" href="style/style.css">
<script type="application/ld+json">{{.Event.StructuredData .Venue}}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="index.html"><span class="mark">X!</span> {{.Event.Short}}</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        <li><a href="about_page.html"{{if eq .Page.Current "about"}} aria-current="page"{{end}}>About</a></li>
        <li><a href="index.html#program">Program</a></li>
        <li><a href="index.html#schedule">Schedule</a></li>
        <li><a href="index.html#speakers">Speakers</a></li>
        <li><a href="index.html#venue">Venue</a></li>
        <li><a href="index.html#partners">Partners</a></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{{template "content" .}}
</main>
<section class="partners" id="partners" aria-labelledby="partners-title">
  <div class="wrap">
    <h2 id="partners-title">Partners</h2>
    <ul class="partner-list">
      {{- range .Event.Partners}}
      <li><img src="{{.Logo}}" alt="{{.Name}}" width="120" height="60" loading="lazy"></li>
      {{- end}}
    </ul>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap footer-row">
    <span class="wordmark"><span class="mark">X!</span> {{.Event.Short}}</span>
    <p>&copy; {{.Event.Year}} {{.Event.Short}} by Raphael Miyoyo. Questions: <a href="mailto:{{.Event.Email}}">{{.Event.Email}}</a></p>
    <p class="disclaimer">A portfolio project. The speakers, partners and past summits are placeholders, and the partner logos don't mean those companies are involved.</p>
  </div>
</footer>
<script src="scripts/script.js"></script>
</body>
</html>
{{end}}
